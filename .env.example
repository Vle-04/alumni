# ─── Database ───────────────────────────────────────────────
# Postgres connection string. docker compose maps Postgres to host port 5440.
DATABASE_URL=postgresql://alumni:alumni@localhost:5440/alumni
# Used by integration + e2e tests only (created automatically by scripts/db-init).
TEST_DATABASE_URL=postgresql://alumni:alumni@localhost:5440/alumni_test

# ─── App ────────────────────────────────────────────────────
# Public base URL used to build links in emails (no trailing slash). Also pins Auth.js's URL
# (AUTH_URL defaults to $APP_URL/api/auth) so sign-in links are never built from request headers.
APP_URL=http://localhost:3000
# Academy default IANA time zone (used when a graduate has none set).
ACADEMY_TIMEZONE=UTC
# Current privacy-policy version recorded on every consent grant.
PRIVACY_POLICY_VERSION=2026-01

# ─── Secrets (generate each with: openssl rand -base64 32) ──
# Auth.js session/cookie secret.
AUTH_SECRET=
# Comma-separated, versioned AES-256-GCM keys for contact-field encryption, newest first.
# Format: v<N>:<base64 32-byte key>. Old keys stay listed so existing data can be decrypted.
DATA_ENCRYPTION_KEYS=
# HMAC key for blind indexes (email lookup without decryption). Never rotate without re-indexing.
BLIND_INDEX_KEY=
# HMAC key for graduate / partner personal links.
TOKEN_SIGNING_KEY=

# ─── Staff sign-in ──────────────────────────────────────────
# Staff sign in with email + password (no self sign-up; admins add users under Admin → Staff users).
# Optional "Continue with Google" for non-admin staff (admins are always password-only).
# Create an OAuth client (Web application) in Google Cloud Console → APIs & Services → Credentials,
# with the authorized redirect URI  $APP_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional OIDC SSO (same rules as Google).
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
# Trust the host header behind a reverse proxy (set true in Docker/production behind TLS).
AUTH_TRUST_HOST=true

# ─── Email ──────────────────────────────────────────────────
# console | smtp | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM="Academy Careers <careers@academy.example>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
RESEND_API_KEY=

# ─── Client IP (rate limits, lockouts, audit) ───────────────
# How many reverse proxies in front of the app append to X-Forwarded-For. 0 (default) = ignore the
# header and use the connecting socket's address. Set to N only if the app is reachable ONLY
# through those N proxies (otherwise clients can spoof their IP). See README → Deploying.
TRUSTED_PROXY_HOPS=0
# Alternatively, a header your proxy/CDN sets and OVERWRITES on every request (e.g. cf-connecting-ip).
# When set, it is the only source of the client IP.
CLIENT_IP_HEADER=
# Port for `npm start` / `npm run dev` (the custom server in server.ts).
PORT=3000

# ─── Logging ────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
